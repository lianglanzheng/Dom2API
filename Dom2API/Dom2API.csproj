<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ApplicationIcon>Assets\Dom2API.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="Assets\Dom2API.ico" />
        <Resource Include="Assets\Dom2API.png" />
        <EmbeddedResource Include="Services\ApplyUpdate.ps1" />
        <Using Remove="System.Windows.Forms" />
        <Using Remove="System.Drawing" />
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
        <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    </ItemGroup>

</Project>
