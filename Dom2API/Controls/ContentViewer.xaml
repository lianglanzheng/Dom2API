<UserControl x:Class="Dom2API.Controls.ContentViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Dom2API.Models" Background="White">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:ContentTreeNode}" ItemsSource="{Binding Children}">
            <HierarchicalDataTemplate.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="False" />
                </Style>
            </HierarchicalDataTemplate.ItemContainerStyle>
            <TextBlock Text="{Binding Header}" FontFamily="Consolas, Microsoft YaHei UI" />
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="14,8,14,6">
            <CheckBox x:Name="PlainTextOption" Content="纯文本" DockPanel.Dock="Right"
                      Visibility="Collapsed" Click="PlainTextOption_Click" AutomationProperties.Name="切换纯文本显示" />
            <TextBlock x:Name="FormatLabel" Text="纯文本" Foreground="#626B72" />
        </DockPanel>
        <TreeView x:Name="ContentTree" Grid.Row="1" BorderThickness="0" Padding="10,4"
                  Visibility="Collapsed" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                  AutomationProperties.Name="结构化内容">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
        <TextBox x:Name="PlainText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI"
                 BorderThickness="0" Padding="14" AutomationProperties.Name="原始内容全文" />
    </Grid>
</UserControl>
