                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Foreground="#27324B" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="28">
                        <Border Background="White" BorderBrush="#DDE4F0" BorderThickness="1" CornerRadius="16" Padding="20" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="网络记录导出" FontSize="17" FontWeight="Bold" />
                                <Grid Height="8" />
                                <TextBlock Text="将当前全部请求信息、HTTP 内容和 SSE 事件保存为 JSON 文件。进行中的请求导出当前已捕获的内容。"
                                           Foreground="#667085" TextWrapping="Wrap" />
                                <Grid Height="16" />
                                <Button x:Name="ExportNetworkRecordsButton" Content="导出所有网络记录" Click="ExportNetworkRecords_Click"
                                        HorizontalAlignment="Left" Background="#4892F1" Foreground="White" BorderBrush="#4892F1"
                                        AutomationProperties.Name="导出所有网络记录">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NetworkExportStatus}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid Height="12" />
                                    <TextBlock x:Name="NetworkExportStatus" Text="" Foreground="#667085" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="1" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="#DDE4F0" BorderThickness="0,1,0,0" Padding="24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ActiveRequestSummary}" Foreground="#986500">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveRequestSummary}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
