<Window x:Class="Dom2API.AccountPresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建账号预设" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F3F1" Foreground="#24304A">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7DEED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#24304A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="预设名称" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" Padding="8,6" MaxLength="80" AutomationProperties.Name="预设名称" />
        <TextBlock x:Name="SnapshotText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#626B72" />
        <CheckBox x:Name="UpdateStatesBox" Content="以当前账号启用情况更新此预设" IsChecked="True" Margin="0,12,0,0" />
        <TextBlock Text="勾选主窗口的“记住连接配置和账号”后，预设将在下次启动时保留。" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#626B72" />
        <TextBlock x:Name="ErrorText" Foreground="#B0343B" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" IsCancel="True" Margin="0,0,12,0" />
            <Button Content="保存" IsDefault="True" Click="Save_Click" Background="#4892F1" Foreground="White" BorderBrush="#4892F1" />
        </StackPanel>
    </StackPanel>
</Window>
